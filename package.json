{
  "name": "scope-creep-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Cumulative scope-tracking ledger for freelancers and small agencies",
  "workspaces": [
    "apps/*",
    "services/*",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "test:backend": "npx tsx services/test-all.ts",
    "test:e2e": "npm run test:e2e --workspace=apps/web",
    "test": "npm run test:backend && npm run test:e2e"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
