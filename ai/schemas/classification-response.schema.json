{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BedrockClassificationResponse",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "message_id",
          "classification",
          "confidence",
          "reason",
          "estimated_hours"
        ],
        "properties": {
          "message_id": {
            "type": "string",
            "description": "Matching unique message identifier from the input batch"
          },
          "classification": {
            "type": "string",
            "enum": ["in-scope", "new-ask", "clarification", "off-topic"],
            "description": "Exactly one of the four valid categories"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Confidence rating from 0.0 to 1.0"
          },
          "reason": {
            "type": "string",
            "description": "Brief explicit justification explaining why this classification was chosen"
          },
          "estimated_hours": {
            "type": ["number", "null"],
            "minimum": 0.0,
            "description": "Estimated hours for work required. Null for in-scope, clarification, or off-topic."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
