# ALXO Scope Creep Ledger — Environment Variables Template
# Copy this file to .env and populate with your environment configuration.

# ==============================================================================
# AWS Regional & Credential Configuration
# ==============================================================================
# Note for AWS Amplify: Custom env variables cannot start with 'AWS_'.
# Use APP_AWS_REGION, APP_AWS_ACCESS_KEY_ID, APP_AWS_SECRET_ACCESS_KEY.
APP_AWS_REGION=ap-southeast-2
APP_AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
APP_AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Standard AWS SDK fallback keys (optional if APP_AWS_* are set)
# AWS_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Set to true for offline local testing without AWS infrastructure
MOCK_DYNAMODB=false
MOCK_BEDROCK=false

# ==============================================================================
# Amazon Bedrock AI Model Configuration
# ==============================================================================
# Model ID for message classification and change-order email generation (Claude 3 Haiku)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ==============================================================================
# Amazon S3 Storage Configuration
# ==============================================================================
# S3 bucket for storing raw uploaded conversation export files (.txt, .csv)
S3_BUCKET_NAME=scope-creep-ledger-conversations-dev

# ==============================================================================
# Amazon DynamoDB Table Names
# ==============================================================================
# DynamoDB tables for storing project metadata, authoritative ledger items, and cloud logs
DYNAMODB_PROJECTS_TABLE=scope-creep-ledger-projects-dev
DYNAMODB_LEDGER_TABLE=scope-creep-ledger-items-dev
DYNAMODB_ACTIVITY_TABLE=scope-creep-ledger-activity-dev

# ==============================================================================
# Backend API & Application Settings
# ==============================================================================
# Base URL for frontend client requests
API_BASE_URL=http://localhost:3000

# AI Classification thresholds
# Classifications with confidence < CONFIDENCE_THRESHOLD are flagged for user review
CONFIDENCE_THRESHOLD=0.70
# Number of messages sent to Bedrock in a single classification batch
BATCH_SIZE=10

# ==============================================================================
# AWS Cognito User Pool Configuration
# ==============================================================================
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-southeast-2_pgn6MHQFI
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=3jn9qmoc71pne25b97juafqbc9
