# Scope Creep Ledger - Environment Variables Template

# AWS Regional Configuration
# Note for AWS Amplify: Custom env variables cannot start with 'AWS_'.
# Use APP_AWS_REGION in Amplify settings.
APP_AWS_REGION=ap-southeast-2


# Amazon Bedrock AI Model Configuration
# Model ID for message classification and change-order email generation
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Amazon S3 Storage Configuration
# S3 bucket for raw uploaded conversation export files (.txt, .csv)
S3_BUCKET_NAME=scope-creep-ledger-conversations-dev

# Amazon DynamoDB Table Names
# Tables for storing project scope metadata and authoritative ledger items
DYNAMODB_PROJECTS_TABLE=scope-creep-ledger-projects-dev
DYNAMODB_LEDGER_TABLE=scope-creep-ledger-items-dev

# Backend API Configuration
# Base URL for frontend client requests
API_BASE_URL=http://localhost:3001

# Application Confidence & Batching Configuration
# Classifications with confidence < CONFIDENCE_THRESHOLD are flagged for user review
CONFIDENCE_THRESHOLD=0.70
# Number of messages sent to Bedrock in a single classification call
BATCH_SIZE=10
